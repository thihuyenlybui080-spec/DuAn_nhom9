<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="462.0" prefWidth="520.0" style="-fx-background-color: c0c43f;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.loginregister.MainController">
    <children>
        <AnchorPane prefHeight="82.0" prefWidth="520.0" style="-fx-background-color: #722F37;">
            <children>
                <ImageView fx:id="libraImageView" fitHeight="83.0" fitWidth="141.0" layoutX="7.0" layoutY="1.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@libra.png" />
                    </image>
                </ImageView>
                <Label layoutX="134.0" layoutY="20.0" prefHeight="47.0" prefWidth="218.0" text="User Management" textFill="#c0c43f">
                    <font>
                        <Font name="Bell MT" size="24.0" />
                    </font>
                </Label>
            </children>
        </AnchorPane>
        
        <Button fx:id="loginButton" alignment="CENTER" layoutX="95.0" layoutY="200.0" mnemonicParsing="false" onAction="#loginButtonOnAction" prefHeight="40.0" prefWidth="354.0" style="-fx-background-color: #722f37;" text="Login" textFill="#c0c43f">
            <font>
                <Font name="Bell MT Bold" size="16.0" />
            </font>
        </Button>
        
        <Button fx:id="registerButton" alignment="CENTER" layoutX="95.0" layoutY="260.0" mnemonicParsing="false" onAction="#registerButtonOnAction" prefHeight="40.0" prefWidth="354.0" style="-fx-background-color: #722f37;" text="Register" textFill="#c0c43f">
            <font>
                <Font name="Bell MT Bold" size="16.0" />
            </font>
        </Button>
        
        <Button fx:id="exitButton" alignment="CENTER" layoutX="95.0" layoutY="380.0" mnemonicParsing="false" onAction="#exitButtonOnAction" prefHeight="30.0" prefWidth="354.0" style="-fx-background-color: #666666;" text="Exit" textFill="#c0c43f">
            <font>
                <Font name="Bell MT Bold" size="14.0" />
            </font>
        </Button>
        
    </children>
</AnchorPane>
