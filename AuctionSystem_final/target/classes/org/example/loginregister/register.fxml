            <font>
                <Font name="Arial Bold" size="13.0" />
            </font>
        </Label>
        <TextField fx:id="firstNameTF" layoutX="29.0" layoutY="121.0" prefHeight="26.0" prefWidth="105.0" promptText="Firstname" />
        <TextField fx:id="lastnameTF" layoutX="184.0" layoutY="121.0" prefHeight="26.0" prefWidth="94.0" promptText="Lastname" />
        <Label layoutX="337.0" layoutY="103.0" text="Username">
            <font>
                <Font name="Arial Bold" size="13.0" />
