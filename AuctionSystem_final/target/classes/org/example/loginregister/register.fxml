<AnchorPane prefHeight="462.0" prefWidth="520.0" style="-fx-background-color: #722f37;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.loginregister.client.controller.RegisterController">
