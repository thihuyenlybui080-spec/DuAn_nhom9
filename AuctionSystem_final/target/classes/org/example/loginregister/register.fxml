                        <Font name="Arial" size="24.0" />
                    </font>
                </Label>
            <Button fx:id="closeButton" alignment="CENTER" layoutX="78.0" layoutY="410.0" mnemonicParsing="false" onAction="#closeButtonOnAction" prefHeight="26.0" prefWidth="142.0" style="-fx-background-color: #722f37;" text="Close" textFill="#c0c43f">
