      <PasswordField fx:id="confirmPasswordPF" layoutX="33.0" layoutY="250.0" prefHeight="26.0" prefWidth="226.0" promptText="Confirm Password" />
      <Label layoutX="336.0" layoutY="159.0" text="Your Role">
         <font>
            <Font name="Arial Bold" size="13.0" />
         </font>
      </Label>
      <ComboBox fx:id="roleComboBox" layoutX="336.0" layoutY="183.0" prefWidth="150.0" promptText="Your Role" style="-fx-background-color: #fffffff;" />
