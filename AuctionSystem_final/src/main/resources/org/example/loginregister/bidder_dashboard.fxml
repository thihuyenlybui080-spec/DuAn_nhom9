<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="rootBorderPane" maxHeight="700.0" maxWidth="1150.0" style="-fx-background-color: #12080a; -fx-background-radius: 20; -fx-overflow: hidden; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.8), 30, 0, 0, 0);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.loginregister.client.controller.BidderDashboardController">

    <left>
        <VBox alignment="TOP_CENTER" prefHeight="700.0" prefWidth="253.0" spacing="5.0" style="-fx-background-color: linear-gradient(to bottom right, #000000, #4E1A21, #000000); -fx-border-color: rgba(114,47,55,0.3); -fx-border-width: 0 1 0 0;">
            <children>
                <VBox alignment="CENTER" prefHeight="150.0" spacing="10.0">
                    <children>
                        <VBox alignment="CENTER">
                            <children>
                                <Label text="NETBID" textFill="#c0c43f">
                                    <font><Font name="Bell MT Bold" size="24.0" /></font>
                                </Label>
                                <Label opacity="0.6" text="AUCTION SYSTEM" textFill="#c0c43f">
                                    <font><Font name="System Bold" size="9.0" /></font>
                                </Label>
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <VBox prefHeight="438.0" prefWidth="231.0" spacing="10.0" VBox.vgrow="ALWAYS">
                    <padding><Insets left="15.0" right="15.0" top="20.0" /></padding>
                    <children>
                        <Label opacity="0.5" text="MAIN MENU" textFill="#c0c43f">
                            <font><Font name="System Bold" size="10.0" /></font>
                            <VBox.margin><Insets left="10.0" /></VBox.margin>
                        </Label>

                        <Button fx:id="btnNavAuctions" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#onNavAuctions" prefHeight="45.0" style="-fx-background-color: #722f37; -fx-background-radius: 10; -fx-cursor: hand;" text="  🚀  Auctions" textFill="#c0c43f">
                            <font><Font name="System Bold" size="13.0" /></font>
                        </Button>

                        <Button fx:id="btnNavHistory" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#onNavHistory" prefHeight="45.0" style="-fx-background-color: transparent; -fx-cursor: hand;" text="  ⌛  Bidding History" textFill="WHITE">
                            <font><Font name="System Bold" size="13.0" /></font>
                        </Button>

                        <Button fx:id="btnNavWon" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#onNavWon" prefHeight="45.0" style="-fx-background-color: transparent; -fx-cursor: hand;" text="  🏆  Won Items" textFill="WHITE">
                            <font><Font name="System Bold" size="13.0" /></font>
                        </Button>
                    </children>
                </VBox>

                <VBox alignment="CENTER" prefHeight="113.0" prefWidth="232.0" spacing="10.0" style="-fx-background-color: rgba(114,47,55,0.1);">
                    <children>
                        <HBox alignment="CENTER" spacing="10.0">
                            <children>
                                <Circle fill="#c0c43f" radius="18.0" stroke="BLACK" strokeType="INSIDE" />
                                <VBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label fx:id="lblUserName" text="User" textFill="WHITE">
                                            <font><Font name="System Bold" size="14.0" /></font>
                                        </Label>
                                        <Label opacity="0.8" text="Bidder" textFill="#c0c43f">
                                            <font><Font size="11.0" /></font>
                                        </Label>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                        <Button fx:id="btnSignOut" onAction="#onSignOut" style="-fx-background-color: transparent; -fx-border-color: #722f37; -fx-border-radius: 5; -fx-cursor: hand;" text="Sign Out" textFill="#722f37">
                            <font><Font name="System Bold" size="11.0" /></font>
                        </Button>
                    </children>
                    <VBox.margin><Insets bottom="10.0" left="10.0" right="10.0" /></VBox.margin>
                </VBox>
            </children>
        </VBox>
    </left>

    <center>
        <VBox prefHeight="700.0" prefWidth="1046.0">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="80.0" style="-fx-background-color: linear-gradient(to bottom right, #000000, #4E1A21, #000000); -fx-border-color: rgba(114,47,55,0.2); -fx-border-width: 0 0 1 0;">
                    <padding><Insets left="25.0" right="25.0" /></padding>
                    <children>
                        <VBox alignment="CENTER_LEFT">
                            <children>
                                <Label fx:id="lblPageTitle" text="Auction Sessions" textFill="WHITE">
                                    <font><Font name="System Bold" size="22.0" /></font>
                                </Label>
                                <Label fx:id="lblSubtitle" opacity="0.8" text="Live: 0 · Upcoming: 0 · Total: 0" textFill="#c0c43f" />
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox fx:id="searchBox" alignment="CENTER" prefHeight="40" prefWidth="307.0" style="-fx-background-color: #1a0a0c; -fx-background-radius: 20; -fx-border-color: #3d1c21; -fx-border-radius: 20;">
                            <children>
                                <Label text=" 🔍 " textFill="#c0c43f">
                                    <font><Font size="16.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="txtSearch" onAction="#onSearch" promptText="Search auctions..." style="-fx-background-color: transparent; -fx-text-fill: white;" HBox.hgrow="ALWAYS" />
                            </children>
                            <padding><Insets left="10.0" right="10.0" /></padding>
                            <HBox.margin>
                                <Insets bottom="10.0" top="10.0" />
                            </HBox.margin>
                        </HBox>
                    </children>
                </HBox>

                <HBox fx:id="filterbar" alignment="CENTER_LEFT" prefHeight="60.0" spacing="15.0">
                    <padding><Insets left="25.0" right="25.0" /></padding>
                    <children>
                        <ToggleButton fx:id="btnAll" mnemonicParsing="false" onAction="#onCategoryAll" selected="true" style="-fx-background-color: #722f37; -fx-text-fill: #c0c43f; -fx-background-radius: 15;" text="All Sessions">
                            <toggleGroup>
                                <ToggleGroup fx:id="categoryGroup" />
                            </toggleGroup></ToggleButton>
                        <ToggleButton fx:id="btnVehicles" mnemonicParsing="false" onAction="#onCategoryVehicles" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-border-color: #3d1c21; -fx-border-radius: 15;" text="Vehicles" toggleGroup="$categoryGroup" />
                        <ToggleButton fx:id="btnElectronics" mnemonicParsing="false" onAction="#onCategoryElectronics" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-border-color: #3d1c21; -fx-border-radius: 15;" text="Electronics" toggleGroup="$categoryGroup" />
                        <ToggleButton fx:id="btnArt" mnemonicParsing="false" onAction="#onCategoryArt" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-border-color: #3d1c21; -fx-border-radius: 15;" text="Art" toggleGroup="$categoryGroup" />

                        <Region HBox.hgrow="ALWAYS" />

                        <Label opacity="0.6" text="Sort Status:" textFill="#c0c43f" />
                        <ComboBox fx:id="cmbStatus" onAction="#onStatusChanged" prefWidth="130.0" promptText="Select" style="-fx-background-color: #1a0a0c; -fx-border-color: #c0c43f; -fx-border-radius: 8;" />
                    </children>
                </HBox>

                <StackPane prefHeight="525.0" prefWidth="379.0" VBox.vgrow="ALWAYS">
                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="10.0" /></padding>
                    <children>
                        <ScrollPane fx:id="paneAuctions" fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: #000; -fx-background-radius: 15; -fx-border-radius: 15;">
                            <content>
                                <VBox fx:id="auctionContainer" spacing="15.0">
                                    <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
                                </VBox>
                            </content>
                        </ScrollPane>

                        <VBox fx:id="paneHistory" alignment="CENTER" spacing="10.0" visible="false">
                            <children>
                                <Label text="Bidding History" textFill="#c0c43f">
                                    <font><Font name="System Bold" size="20.0" /></font>
                                </Label>
                                <Label opacity="0.4" text="No records found yet." textFill="WHITE" />
                            </children>
                        </VBox>

                        <VBox fx:id="paneWon" alignment="CENTER" spacing="10.0" visible="false">
                            <children>
                                <Label text="Won Sessions" textFill="#c0c43f">
                                    <font><Font name="System Bold" size="20.0" /></font>
                                </Label>
                                <Label opacity="0.4" text="Winning items will appear here." textFill="WHITE" />
                            </children>
                        </VBox>
                    </children>
                </StackPane>

                <HBox alignment="CENTER_LEFT" prefHeight="35.0" style="-fx-background-color: #1a0a0c;">
                    <padding><Insets left="20.0" right="20.0" /></padding>
                    <children>
                        <Circle fill="#00ff11" radius="4.0" stroke="TRANSPARENT" />
                        <Label fx:id="lblUpdate" text=" Server Connected" textFill="#00ff11" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblCount" opacity="0.5" text="Showing 0 sessions" textFill="WHITE" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>
