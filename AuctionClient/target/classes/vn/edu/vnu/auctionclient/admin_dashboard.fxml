<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="rootBorderPane" prefHeight="720.0" prefWidth="1150.0" style="-fx-background-color: #0a0405;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vn.edu.vnu.auction.controller.AdminDashboardController"> <left>
    <VBox alignment="TOP_CENTER" prefHeight="720.0" prefWidth="253.0" style="-fx-background-color: linear-gradient(to bottom right, #000000, #4E1A21, #000000); -fx-border-color: rgba(114,47,55,0.3); -fx-border-width: 0 1 0 0;" BorderPane.alignment="CENTER">

        <VBox alignment="CENTER" prefHeight="120.0">
            <Label text="NETBID" textFill="#c0c43f">
                <font><Font name="Bell MT Bold" size="20.0" /></font>
                <VBox.margin><Insets top="10.0" /></VBox.margin>
            </Label>
            <Label opacity="0.6" text="CONTROL PANEL" textFill="#c0c43f">
                <font><Font name="System Bold" size="9.0" /></font>
            </Label>
        </VBox>
         <Region prefHeight="38.0" prefWidth="253.0" />

        <VBox prefHeight="59.0" prefWidth="253.0" spacing="8.0" VBox.vgrow="ALWAYS">
            <padding><Insets left="15.0" right="15.0" top="20.0" /></padding>
            <Label text="MANAGEMENT" textFill="#c0c43f8c">
               <font>
                  <Font name="System Bold" size="10.0" />
               </font>
            </Label>

            <Button fx:id="btnNavUsers" alignment="TOP_LEFT" maxWidth="Infinity" onAction="#onNavUsers" style="-fx-background-color: #722f37; -fx-background-radius: 8; -fx-cursor: hand;" text=" ● Manage Users" textFill="#c0c43f">
                <font><Font name="System Bold" size="13.0" /></font>
                <padding><Insets bottom="12.0" left="10.0" top="12.0" /></padding>
            </Button>

            <Button fx:id="btnNavAuctions" alignment="TOP_LEFT" maxWidth="Infinity" onAction="#onNavAuctions" style="-fx-background-color: transparent; -fx-cursor: hand;" text=" ● Manage Auctions" textFill="WHITE">
                <font><Font name="System Bold" size="13.0" /></font>
                <padding><Insets bottom="12.0" left="10.0" top="12.0" /></padding>
            </Button>
        </VBox>

        <Region prefHeight="139.0" prefWidth="253.0" VBox.vgrow="ALWAYS" />
         <VBox alignment="CENTER" prefHeight="129.0" prefWidth="253.0" spacing="10.0" style="-fx-background-color: rgba(114,47,55,0.1);">
            <children>
               <HBox alignment="CENTER" spacing="10.0">
                  <children>
                     <Circle fill="#c0c43f" radius="18.0" stroke="BLACK" strokeType="INSIDE" />
                     <VBox alignment="CENTER_LEFT">
                        <children>
                           <Label fx:id="lblUsername" text="Admin" textFill="WHITE">
                              <font>
                                 <Font name="System Bold" size="14.0" />
                              </font>
                           </Label>
                           <Label opacity="0.8" text="Admin" textFill="#c0c43f">
                              <font>
                                 <Font size="11.0" />
                              </font>
                           </Label>
                        </children>
                     </VBox>
                  </children>
               </HBox>
               <Button fx:id="btnSignOut" onAction="#onSignOut" style="-fx-background-color: transparent; -fx-border-color: #722f37; -fx-border-radius: 5; -fx-cursor: hand;" text="Sign Out" textFill="#722f37">
                  <font>
                     <Font name="System Bold" size="11.0" />
                  </font>
               </Button>
            </children>
         </VBox>
    </VBox>
</left>

    <center>
        <VBox style="-fx-background-color: #12080a;"> <HBox alignment="CENTER_LEFT" prefHeight="89.0" prefWidth="897.0" spacing="15.0" style="-fx-background-color: linear-gradient(to bottom right, #000000, #4E1A21, #000000); -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 10, 0, 0, 0);">
            <padding><Insets left="20.0" right="20.0" /></padding>
            <VBox alignment="CENTER_LEFT" spacing="2.0">
                <Label fx:id="lblPageTitle" text="Manage Users" textFill="WHITE">
                    <font><Font name="System Bold" size="20.0" /></font>
                </Label>
                <Label fx:id="lblSubtitle" opacity="0.6" style="-fx-font-size: 11px;" text="Administrative control over user accounts" textFill="#c0c43f" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />

            <HBox fx:id="searchBox" alignment="CENTER_LEFT" maxHeight="40.0" prefHeight="40.0" spacing="8.0" style="-fx-background-color: #0a0405; -fx-background-radius: 20; -fx-border-color: #3d1c21; -fx-border-radius: 20;">
                <padding><Insets left="15.0" right="15.0" /></padding>
                <Label style="-fx-text-fill: #c0c43f;" text="🔍" />
                <TextField fx:id="txtSearch" onKeyReleased="#onSearch" prefHeight="35.0" prefWidth="200.0" promptText="Search registry..." style="-fx-background-color: transparent; -fx-text-fill: white; -fx-prompt-text-fill: #555;" />
               <HBox.margin>
                  <Insets bottom="10.0" top="10.0" />
               </HBox.margin>
            </HBox>
        </HBox>

            <StackPane VBox.vgrow="ALWAYS">
                <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>

                <VBox fx:id="paneUsers" spacing="15.0">
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                  <Label prefHeight="18.0" prefWidth="38.0" text="Role" textFill="#c0c43f" />
                        <ComboBox fx:id="cmbRoleFilter" onAction="#onRoleFilterChanged" prefWidth="130.0" style="-fx-background-color: #1a0a0c; -fx-border-color: #c0c43f; -fx-border-radius: 8;">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="All Roles" />
                                    <String fx:value="Bidder" />
                                    <String fx:value="Seller" />
                                    <String fx:value="Admin" />
                                </FXCollections>
                            </items>
                        </ComboBox>
                  <Label text="Status" textFill="#c0c43f" />

                        <ComboBox fx:id="cmbStatusFilter" onAction="#onStatusFilterChanged" prefWidth="130.0" style="-fx-background-color: #1a0a0c; -fx-border-color: #c0c43f; -fx-border-radius: 8;">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="All Status" />
                                    <String fx:value="Active" />
                                    <String fx:value="Locked" />
                                </FXCollections>
                            </items>
                        </ComboBox>

                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblUserCount" style="-fx-font-weight: bold; -fx-font-size: 11px;" text="0 USERS LOADED" textFill="#c0c43f" />
                    </HBox>

                    <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: #000; -fx-border-radius: 15; -fx-background-radius: 15;" VBox.vgrow="ALWAYS">
                        <VBox fx:id="userListContainer" spacing="10.0">

                        </VBox>
                    </ScrollPane>
                </VBox>

                <VBox fx:id="paneAuctions" spacing="15.0" visible="false">
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <ComboBox fx:id="cmbAuctionFilter" onAction="#onAuctionFilterChanged" prefWidth="150.0" style="-fx-background-color: #1a0a0c; -fx-border-color: #c0c43f; -fx-border-radius: 5;">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="All Status" />
                                    <String fx:value="Live" />
                                    <String fx:value="Upcoming" />
                                    <String fx:value="Finished" />
                                </FXCollections>
                            </items>
                        </ComboBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblAuctionCount" style="-fx-font-weight: bold; -fx-text-fill: #c0c43f; -fx-font-size: 11px;" text="0 AUCTIONS FOUND" />
                    </HBox>

                    <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: #3d1c21; -fx-border-radius: 15;" VBox.vgrow="ALWAYS">
                        <VBox fx:id="auctionListContainer" spacing="10.0">
                        </VBox>
                    </ScrollPane>
                </VBox>
            </StackPane>

            <HBox alignment="CENTER_LEFT" prefHeight="40.0" spacing="10.0" style="-fx-background-color: #0a0405;">
                <padding><Insets left="20.0" right="20.0" /></padding>
                <Label fx:id="lblStatusBar" style="-fx-text-fill: #00ff11; -fx-font-size: 10px; -fx-font-weight: bold;" text="SYSTEM READY" />
                <Region HBox.hgrow="ALWAYS" />
                <Label style="-fx-text-fill: #722f37; -fx-font-size: 10px; -fx-font-weight: bold;" text="● SECURE ADMIN MODE" />
            </HBox>

        </VBox>
    </center>

</BorderPane>
